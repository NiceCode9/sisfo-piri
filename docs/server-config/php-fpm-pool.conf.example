; PHP-FPM tuning untuk 500 VU CBT — sesuaikan RAM VPS (contoh 4GB)
; Letakkan di /etc/php/8.3/fpm/pool.d/www.conf (staging)

[www]
pm = dynamic
pm.max_children = 50
pm.start_servers = 10
pm.min_spare_servers = 10
pm.max_spare_servers = 20
pm.max_requests = 500

; Batas unggah. Default php.ini (2M/8M) jauh di bawah kebutuhan import soal
; CBT: satu paket berisi 40 foto HP (±3 MB) bisa 120 MB, dan sebagai zip masih
; bisa 50-an MB. Nilai di bawah menutup kasus itu.
; PENTING: post_max_size harus lebih besar dari upload_max_filesize, kalau tidak
; PHP membuang POST lebih dulu dan pesan errornya jadi nol byte.
upload_max_filesize = 50M
post_max_size = 52M
upload_tmp_size = 52M
; Paket 50 MB butuh waktu untuk diekstrak dan dibaca, jadi batas eksekusi
; dan request_terminate_timeout ikut dinaikkan.
max_execution_time = 120

; timeout & log
request_terminate_timeout = 180s
slowlog = /var/log/php-fpm-slow.log
request_slowlog_timeout = 10s
