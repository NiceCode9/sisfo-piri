# Template env untuk deploy Docker penuh (branch eksperimen/docker-deploy).
# Cara pakai: salin menjadi `backend/.env` lalu sesuaikan nilai bertanda GANTI.
# Nilai DB_HOST / REDIS_HOST / WHATSAPP_URL JANGAN diubah — itu nama service compose.
# Untuk varian A (CBT beda server) dan B (satu server): file ini SAMA.
# Bedanya hanya di server CBT: VITE_API_BASE_URL menunjuk ke APP_URL di bawah.

APP_NAME="Sisfo Piri"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://admin.ncode.my.id
APP_KEY=base64:GANTI_DENGAN_HASIL_php_artisan_key_generate

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=sisfo_piri
DB_USERNAME=sisfo
DB_PASSWORD=GANTI_PASSWORD_DB

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

WHATSAPP_URL=http://wa-gateway:3001/kirim
WHATSAPP_TOKEN=GANTI_32_CHAR_SAMA_DENGAN_GATEWAY_TOKEN

FILESYSTEM_DISK=public
LOG_CHANNEL=daily
LOG_LEVEL=warning
